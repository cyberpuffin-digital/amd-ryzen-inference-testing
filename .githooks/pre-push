#!/bin/sh
# Refuse a push whose commits (tree, messages, author and committer) contain
# a private name (bench/redact.py). Runs for every remote, mirrors included.
top=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue            # branch deletion
    if [ "$remote_sha" = "$zero" ]; then
        range=$local_sha                              # new branch: all its history
    else
        range=$remote_sha..$local_sha
    fi
    python3 "$top/bench/redact.py" check --push "$range" || status=1
done
exit $status
